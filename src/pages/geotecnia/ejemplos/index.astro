---
import PageLayout from '../../../layouts/PageLayout.astro';
import PostCard from '../../../components/ui/PostCard.astro';
import TemaFilter from '../../../components/ui/TemaFilter.astro';
import { getGeotecniaPostsBySubsection, SUBSECTIONS } from '../../../lib/geotecnia';
import { contarTemas } from '../../../lib/temas';

const sub = SUBSECTIONS['ejemplos'];
const posts = await getGeotecniaPostsBySubsection('ejemplos');

// Los ejemplos se ordenan por capítulo de origen, no por fecha (mismo criterio
// que /hormigon/ejemplos), para que se lean en el orden real de diseño.
const capNum = (chapter?: string) => parseInt(chapter?.match(/\d+/)?.[0] ?? '999');
const sorted = [...posts].sort((a, b) => capNum(a.data.chapter) - capNum(b.data.chapter));

const temaDe = (p: (typeof sorted)[number]) => p.data.tema ?? 'Otros';
const temas = contarTemas(sorted.map(temaDe));
const total = sorted.length;
---
<PageLayout title={sub.label} description={sub.description}>
  <div class="mb-10">
    <a href="/geotecnia" class="text-sm text-muted hover:text-ink transition-colors">
      &larr; Geotecnia
    </a>
    <div class="mt-4">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-2">
        {sub.norm}
      </p>
      <h1 class="text-2xl font-semibold text-ink mb-3">{sub.label}</h1>
      <p class="text-muted leading-relaxed mb-3">{sub.description}</p>
      <p class="text-muted text-sm" data-count>{total} ejemplo{total !== 1 ? 's' : ''}</p>
    </div>
  </div>

  <TemaFilter temas={temas} noun="ejemplo" />

  {total > 0 ? (
    <section data-list>
      {sorted.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          href={`/geotecnia/${post.id}`}
          tags={post.data.tags}
          section={post.data.chapter}
          data-tema={temaDe(post)}
        />
      ))}
    </section>
  ) : (
    <p class="text-muted">No hay ejemplos publicados todavía.</p>
  )}
</PageLayout>
