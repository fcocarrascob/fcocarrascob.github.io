    {
      "id": "r174",
      "kind": "math",
      "x": 40,
      "y": 8312,
      "src": "q_cm := 2*0.75*0.6*F_EXX*0.707 = tonf/cm^2"
    },
    {
      "id": "r175",
      "kind": "math",
      "x": 40,
      "y": 8358,
      "src": "w_des := q_rq/q_cm = cm"
    },
    {
      "id": "r176",
      "kind": "math",
      "x": 40,
      "y": 8404,
      "src": "w_nt := 0.62*t_g = cm"
    },
    {
      "id": "r177",
      "kind": "math",
      "x": 40,
      "y": 8450,
      "src": "w_mx := t_g - 0.2 cm = cm"
    },
    {
      "id": "v_wdes",
      "kind": "math",
      "x": 40,
      "y": 8496,
      "src": "w_i >= w_des ="
    },
    {
      "id": "v_wmax",
      "kind": "math",
      "x": 40,
      "y": 8542,
      "src": "w_i <= w_mx ="
    },
    {
      "id": "v_wnote",
      "kind": "math",
      "x": 40,
      "y": 8588,
      "src": "w_nt >= w_des ="
    },
    {
      "id": "r181",
      "kind": "text",
      "x": 40,
      "y": 8634,
      "src": "Interfaz con la VIGA"
    },
    {
      "id": "r182",
      "kind": "math",
      "x": 40,
      "y": 8680,
      "src": "Rdv_b := 1.00*0.6*F_y*t_g*L_b = tonf"
    },
    {
      "id": "r183",
      "kind": "math",
      "x": 40,
      "y": 8726,
      "src": "Rdn_b := 0.90*F_y*t_g*L_b = tonf"
