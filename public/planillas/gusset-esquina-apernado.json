    {
      "id": "r149",
      "kind": "math",
      "x": 40,
      "y": 7139,
      "src": "mit := b_w/2 = cm"
    },
    {
      "id": "r150",
      "kind": "math",
      "x": 40,
      "y": 7185,
      "src": "L1 := min((s_ul*cos_t - e_b)/cos_t, (s_ul*sen_t - e_c)/sen_t) = cm"
    },
    {
      "id": "r151",
      "kind": "math",
      "x": 40,
      "y": 7231,
      "src": "x2 := s_ul*sen_t + mit*cos_t = cm"
    },
    {
      "id": "r152",
      "kind": "math",
      "x": 40,
      "y": 7277,
      "src": "y2 := s_ul*cos_t - mit*sen_t = cm"
    },
    {
      "id": "r153",
      "kind": "math",
      "x": 40,
      "y": 7323,
      "src": "L2 := min((y2 - e_b)/cos_t, (x2 - e_c)/sen_t) = cm"
    },
    {
      "id": "r154",
      "kind": "math",
      "x": 40,
      "y": 7369,
      "src": "x3 := s_ul*sen_t - mit*cos_t = cm"
    },
    {
      "id": "r155",
      "kind": "math",
      "x": 40,
      "y": 7415,
      "src": "y3 := s_ul*cos_t + mit*sen_t = cm"
    },
    {
      "id": "r156",
      "kind": "math",
      "x": 40,
      "y": 7461,
      "src": "L3 := min((y3 - e_b)/cos_t, (x3 - e_c)/sen_t) = cm"
    },
    {
      "id": "r157",
      "kind": "math",
      "x": 40,
      "y": 7507,
      "src": "L_pr := (L1 + L2 + L3)/3 = cm"
    },
    {
      "id": "r158",
      "kind": "math",
      "x": 40,
      "y": 7553,
      "src": "L_mx := max(L1, L2, L3) = cm"
    },
    {
      "id": "v_cabe",
      "kind": "math",
      "x": 40,
      "y": 7599,
      "src": "min(L1, L2, L3) > 0 cm ="
    },
    {
      "id": "r160",
      "kind": "math",
      "x": 40,
      "y": 7645,
      "src": "r_b := t_g/sqrt(12) = cm"
    },
    {
      "id": "r161",
      "kind": "math",
      "x": 40,
      "y": 7691,
      "src": "umb := 25*r_b = cm"
    },
    {
      "id": "r162",
      "kind": "text",
      "x": 40,
      "y": 7737,
      "src": "El promedio cae bajo el umbral y el máximo no: la elección decide la rama de J4.4"
    },
    {
      "id": "v_umbp",
      "kind": "math",
      "x": 40,
      "y": 7783,
      "src": "L_pr <= umb ="
    },
    {
      "id": "v_umbm",
      "kind": "math",
      "x": 40,
      "y": 7829,
      "src": "L_mx > umb ="
    },
    {
      "id": "r165",
      "kind": "math",
      "x": 40,
      "y": 7875,
      "src": "K_g := 1.2"
    },
    {
      "id": "r166",
      "kind": "math",
      "x": 40,
      "y": 7921,
      "src": "esb_g := K_g*L_mx/r_b ="
    },
    {
      "id": "r167",
      "kind": "math",
      "x": 40,
      "y": 7967,
      "src": "esb_25 := 25"
    },
    {
      "id": "r168",
      "kind": "program",
      "x": 40,
      "y": 8013,
      "src": "F_ng :=\n    if esb_g <= esb_25\n        return F_y\n    lim2 := 4.71*sqrt(E/F_y)\n    F_eg := pi^2*E/esb_g^2\n    if esb_g <= lim2\n        return 0.658^(F_y/F_eg)*F_y\n    return 0.877*F_eg"
    },
    {
      "id": "r169",
      "kind": "math",
      "x": 40,
      "y": 8059,
      "src": "Rd_pan := 0.90*F_ng*A_w = tonf"
    },
    {
      "id": "v_pan",
      "kind": "math",
      "x": 40,
      "y": 8105,
      "src": "Rd_pan >= C_req ="
    },
    {
      "id": "r171",
      "kind": "text",
      "x": 40,
      "y": 8174,
      "src": "━━ 6 · LAS DOS INTERFACES, CON LA ENVOLVENTE ━━"
    },
    {
      "id": "r172",
      "kind": "text",
      "x": 40,
      "y": 8220,
      "src": "La pierna la fija la PLANCHA, no la carga (AISC 341-22 F2.6c.4)"
    },
    {
      "id": "r173",
