      "src": "mC := e_b*VbC - a_l*NbC + b_l*NcC - e_c*VcC = tonf*cm"
    },
    {
      "id": "v_mC",
      "kind": "math",
      "x": 40,
      "y": 5667,
      "src": "abs(mC) <= 0.001 tonf*cm ="
    },
    {
      "id": "r119",
      "kind": "text",
      "x": 40,
      "y": 5713,
      "src": "ENVOLVENTE de los tres cierres. OJO: no está en equilibrio, es una cota."
    },
    {
      "id": "r120",
      "kind": "math",
      "x": 40,
      "y": 5759,
      "src": "Vb := max(VbA, VbB, VbC) = tonf"
    },
    {
      "id": "r121",
      "kind": "math",
      "x": 40,
      "y": 5805,
      "src": "Nb := max(NbA, NbB, NbC) = tonf"
    },
    {
      "id": "r122",
      "kind": "math",
      "x": 40,
      "y": 5851,
      "src": "Nc := max(NcA, NcB, NcC) = tonf"
    },
    {
      "id": "r123",
      "kind": "math",
      "x": 40,
      "y": 5897,
      "src": "Vc := max(VcA, VcB, VcC) = tonf"
    },
    {
      "id": "r124",
      "kind": "text",
      "x": 40,
      "y": 5966,
      "src": "━━ 4 · PERNOS (J3) — corte doble ━━"
    },
    {
      "id": "r125",
      "kind": "math",
      "x": 40,
      "y": 6012,
      "src": "A_p := pi/4*d_p^2 = cm^2"
    },
    {
      "id": "r126",
      "kind": "math",
      "x": 40,
      "y": 6058,
      "src": "Rd_cp := 0.75*2*F_nv*A_p = tonf"
    },
    {
      "id": "r127",
      "kind": "math",
      "x": 40,
      "y": 6104,
      "src": "Rd_cg := n_p*Rd_cp = tonf"
    },
    {
      "id": "v_corte",
      "kind": "math",
      "x": 40,
      "y": 6150,
      "src": "Rd_cg >= T_req ="
    },
    {
      "id": "r129",
      "kind": "text",
      "x": 40,
      "y": 6196,
      "src": "J3.11: en la edición 2022 aplastamiento y desgarre son estados límite SEPARADOS"
    },
    {
      "id": "r130",
      "kind": "math",
      "x": 40,
      "y": 6242,
      "src": "Rd_apl := 0.75*2.4*d_p*t_g*F_u = tonf"
    },
    {
      "id": "r131",
      "kind": "math",
      "x": 40,
      "y": 6288,
      "src": "lc_bo := e_bo - d_h/2 = cm"
    },
    {
      "id": "r132",
      "kind": "math",
      "x": 40,
      "y": 6334,
      "src": "lc_in := pas - d_h = cm"
    },
    {
      "id": "r133",
      "kind": "math",
      "x": 40,
      "y": 6380,
      "src": "Rd_dbo := 0.75*1.2*lc_bo*t_g*F_u = tonf"
    },
    {
      "id": "r134",
      "kind": "math",
      "x": 40,
      "y": 6426,
      "src": "Rd_din := 0.75*1.2*lc_in*t_g*F_u = tonf"
    },
    {
      "id": "r135",
      "kind": "math",
      "x": 40,
      "y": 6472,
      "src": "Rd_gg := 2*min(Rd_apl, Rd_dbo) + 4*min(Rd_apl, Rd_din) = tonf"
    },
    {
      "id": "v_apl",
      "kind": "math",
      "x": 40,
      "y": 6518,
      "src": "Rd_gg >= T_req ="
    },
    {
      "id": "v_gob",
      "kind": "math",
      "x": 40,
      "y": 6564,
      "src": "Rd_cg <= Rd_gg ="
    },
    {
      "id": "r138",
      "kind": "text",
      "x": 40,
      "y": 6633,
      "src": "━━ 5 · GUSSET · WHITMORE Y PANDEO ━━"
    },
    {
      "id": "r139",
      "kind": "math",
      "x": 40,
      "y": 6679,
      "src": "l_cn := (n_col - 1)*pas = cm"
    },
    {
      "id": "r140",
      "kind": "math",
      "x": 40,
      "y": 6725,
      "src": "b_w := gam + 2*l_cn*tan(30 deg) = cm"
    },
    {
      "id": "r141",
      "kind": "math",
      "x": 40,
      "y": 6771,
      "src": "A_w := b_w*t_g = cm^2"
    },
    {
      "id": "r142",
      "kind": "math",
      "x": 40,
      "y": 6817,
      "src": "A_wn := (b_w - n_fil*d_h)*t_g = cm^2"
