    {
      "id": "r184",
      "kind": "math",
      "x": 40,
      "y": 8772,
      "src": "int_b := (Vb/Rdv_b)^2 + (Nb/Rdn_b)^2 ="
    },
    {
      "id": "v_intb",
      "kind": "math",
      "x": 40,
      "y": 8818,
      "src": "int_b <= 1 ="
    },
    {
      "id": "r186",
      "kind": "text",
