    },
    {
      "id": "r187",
      "kind": "math",
      "x": 40,
      "y": 8910,
      "src": "Rdv_c := 1.00*0.6*F_y*t_g*L_c = tonf"
    },
    {
      "id": "r188",
      "kind": "math",
      "x": 40,
      "y": 8956,
      "src": "Rdn_c := 0.90*F_y*t_g*L_c = tonf"
    },
    {
      "id": "r189",
      "kind": "math",
      "x": 40,
      "y": 9002,
      "src": "int_c := (Vc/Rdv_c)^2 + (Nc/Rdn_c)^2 ="
    },
    {
      "id": "v_intc",
      "kind": "math",
      "x": 40,
      "y": 9048,
      "src": "int_c <= 1 ="
    },
    {
      "id": "r191",
      "kind": "text",
      "x": 40,
      "y": 9117,
      "src": "━━ 7 · LOS MIEMBROS QUE RECIBEN LA CARGA (J10) ━━"
    },
    {
      "id": "r192",
      "kind": "math",
      "x": 40,
      "y": 9163,
