    {
      "id": "r144",
      "kind": "math",
      "x": 40,
      "y": 6909,
      "src": "Rd_rot := 0.75*F_u*A_wn = tonf"
    },
    {
      "id": "v_flu",
      "kind": "math",
      "x": 40,
      "y": 6955,
      "src": "Rd_flu >= T_req ="
    },
    {
      "id": "v_rot",
      "kind": "math",
      "x": 40,
      "y": 7001,
      "src": "Rd_rot >= T_req ="
    },
    {
      "id": "r147",
      "kind": "text",
      "x": 40,
      "y": 7047,
      "src": "Longitudes de pandeo de Thornton: del borde de la banda al borde soportado"
    },
    {
      "id": "r148",
      "kind": "math",
      "x": 40,
      "y": 7093,
      "src": "s_ul := 60.0 cm"
