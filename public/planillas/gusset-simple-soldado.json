      "id": "r034",
      "kind": "math",
      "x": 40,
      "y": 2115,
      "src": "piso := 0.5*T_ye = tonf"
    },
    {
      "id": "r035",
      "kind": "math",
      "x": 40,
      "y": 2161,
      "src": "T_r := max(min(T_ye, base), piso) = tonf"
    },
    {
      "id": "v_base",
      "kind": "math",
      "x": 40,
