    {
      "id": "r048",
      "kind": "math",
      "x": 40,
      "y": 2576,
      "src": "l_alt := 20 cm"
    },
    {
      "id": "r049",
      "kind": "math",
      "x": 40,
      "y": 2624,
      "src": "U_20 := 1 - x_bar/l_alt ="
    },
    {
      "id": "r050",
      "kind": "math",
      "x": 40,
      "y": 2672,
      "src": "Rd_ro20 := 0.75*F_u*A_n*U_20 = tonf"
    },
    {
      "id": "r051",
      "kind": "text",
      "x": 40,
      "y": 2736,
      "src": "━━ 4 · CORTE DE BLOQUE (Ec. J4-5, phi = 0.75) ━━"
    },
    {
      "id": "r052",
      "kind": "text",
      "x": 40,
      "y": 2784,
      "src": "Cuatro planos de corte de largo l_w sobre t; soldado: sin agujeros (A_nv = A_gv) y sin plano de tracción"
    },
    {
      "id": "r053",
      "kind": "math",
      "x": 40,
      "y": 2832,
      "src": "A_gv := 4*l_w*t_d = cm^2"
    },
    {
      "id": "r054",
      "kind": "math",
      "x": 40,
      "y": 2880,
      "src": "A_nv := A_gv = cm^2"
    },
    {
      "id": "r055",
      "kind": "text",
      "x": 40,
      "y": 2928,
      "src": "Las dos ramas de J4-5, y manda la MENOR: con A_nv = A_gv y F_y < F_u, siempre la segunda"
    },
    {
      "id": "r056",
      "kind": "math",
      "x": 40,
      "y": 2976,
      "src": "Rd_bc := 0.75*min(0.6*F_u*A_nv, 0.6*F_y*A_gv) = tonf"
    },
    {
      "id": "v_bc",
      "kind": "math",
      "x": 40,
      "y": 3024,
      "src": "Rd_bc >= P_u ="
    },
