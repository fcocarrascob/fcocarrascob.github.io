      "id": "r046",
      "kind": "math",
      "x": 40,
      "y": 2715,
      "src": "Rd_sol := 4*Rn_cm*l_w = tonf"
    },
    {
      "id": "v_sol",
      "kind": "math",
      "x": 40,
      "y": 2761,
