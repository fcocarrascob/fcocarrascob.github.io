      "id": "v_rama",
      "kind": "math",
      "x": 40,
      "y": 3072,
      "src": "0.6*F_y*A_gv < 0.6*F_u*A_nv ="
    },
    {
      "id": "r057",
      "kind": "text",
      "x": 40,
      "y": 3120,
      "src": "Quedarse con la primera rama sola sobreestimaría un 24% hacia el lado inseguro"
