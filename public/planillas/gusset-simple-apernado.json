      "src": "━━ 7 · PANDEO DEL GUSSET (J4.4 → Cap. E) — el que GOBIERNA ━━"
    },
    {
      "id": "r096",
      "kind": "math",
      "x": 40,
      "y": 5825,
      "src": "K_g := 1.2"
    },
    {
      "id": "r097",
      "kind": "text",
      "x": 40,
      "y": 5871,
      "src": "K declarado, no derivado: supone el borde libre desplazándose (lado conservador)"
    },
    {
      "id": "r098",
      "kind": "math",
      "x": 40,
      "y": 5917,
      "src": "L_lib := t_sec = cm"
    },
    {
      "id": "r099",
      "kind": "math",
      "x": 40,
      "y": 5963,
      "src": "r_g := t_g/sqrt(12) = cm"
    },
    {
      "id": "r100",
      "kind": "math",
      "x": 40,
      "y": 6009,
      "src": "esb := K_g*L_lib/r_g ="
    },
    {
      "id": "r101",
      "kind": "program",
      "x": 40,
      "y": 6055,
      "src": "F_cr :=\n    if esb <= 25\n        return F_y\n    lim := 4.71*sqrt(E/F_y)\n    F_e := pi^2*E/esb^2\n    if esb <= lim\n        return 0.658^(F_y/F_e)*F_y\n    return 0.877*F_e"
    },
    {
      "id": "r102",
      "kind": "math",
      "x": 40,
      "y": 6101,
      "src": "F_cr = kgf/cm^2"
    },
    {
      "id": "r103",
      "kind": "math",
      "x": 40,
      "y": 6147,
      "src": "Rd_pan := 0.90*F_cr*w_c*t_g = tonf"
    },
    {
      "id": "v_pan",
      "kind": "math",
      "x": 40,
      "y": 6193,
      "src": "Rd_pan >= T_r ="
    },
    {
      "id": "r104",
      "kind": "text",
      "x": 40,
      "y": 6239,
      "src": "La pinza: la rama compacta J4-6 pediría este espesor de plancha, y hay 20 mm"
    },
    {
      "id": "r105",
      "kind": "math",
      "x": 40,
      "y": 6285,
      "src": "t_J46 := w_t*K_g*sqrt(12)/50 = cm"
    },
    {
      "id": "v_pinza",
      "kind": "math",
      "x": 40,
      "y": 6331,
      "src": "t_J46 > t_g ="
    },
    {
      "id": "r106",
      "kind": "math",
      "x": 40,
      "y": 6377,
      "src": "pier := 0.8 cm"
    },
    {
      "id": "r107",
      "kind": "text",
      "x": 40,
      "y": 6446,
      "src": "━━ 8 · INTERFAZ CON EL ALA (J2.4 + Ec. J4-3) ━━"
    },
    {
      "id": "r108",
      "kind": "math",
      "x": 40,
      "y": 6492,
      "src": "Rd_sol := 0.75*0.6*F_EXX*(pier/sqrt(2))*b_sup*2 = tonf"
    },
    {
      "id": "v_sol",
      "kind": "math",
      "x": 40,
      "y": 6538,
      "src": "Rd_sol >= T_r ="
    },
    {
      "id": "r109",
      "kind": "text",
      "x": 40,
      "y": 6584,
      "src": "Y la plancha misma sobre su sección de borde — en el gusset del ápice ESTO gobernaba"
    },
    {
      "id": "r110",
      "kind": "math",
      "x": 40,
      "y": 6630,
      "src": "A_bo := b_sup*t_g = cm^2"
    },
    {
      "id": "r111",
      "kind": "math",
      "x": 40,
      "y": 6676,
      "src": "Rd_vb := 1.00*0.6*F_y*A_bo = tonf"
    },
    {
      "id": "v_vb",
      "kind": "math",
      "x": 40,
      "y": 6722,
      "src": "Rd_vb >= V_i ="
    },
    {
      "id": "r112",
      "kind": "math",
      "x": 40,
      "y": 6768,
      "src": "sig_b := N_i/A_bo = kgf/cm^2"
    },
    {
      "id": "r113",
      "kind": "math",
      "x": 40,
      "y": 6814,
      "src": "tau_b := V_i/A_bo = kgf/cm^2"
    },
    {
      "id": "r114",
      "kind": "math",
      "x": 40,
      "y": 6860,
      "src": "u_vm := sqrt(sig_b^2 + 3*tau_b^2)/(0.90*F_y) ="
    },
    {
      "id": "v_vm",
      "kind": "math",
      "x": 40,
      "y": 6906,
      "src": "u_vm <= 1 ="
    },
    {
      "id": "r115",
      "kind": "text",
      "x": 40,
      "y": 6975,
      "src": "━━ 9 · USOS ━━"
    },
    {
      "id": "r116",
      "kind": "math",
      "x": 40,
      "y": 7021,
      "src": "u_pan := T_r/Rd_pan ="
    },
    {
      "id": "r117",
      "kind": "math",
      "x": 40,
      "y": 7067,
      "src": "u_dro := T_r/Rd_dro ="
    },
    {
      "id": "r118",
      "kind": "math",
      "x": 40,
      "y": 7113,
      "src": "u_len := T_r/min(Rd_lfl, Rd_lro) ="
    },
    {
      "id": "r119",
      "kind": "math",
      "x": 40,
      "y": 7159,
      "src": "u_dfl := T_r/Rd_dfl ="
    },
    {
      "id": "r120",
      "kind": "math",
      "x": 40,
      "y": 7205,
      "src": "u_bc := T_r/Rd_bc ="
    },
    {
      "id": "r121",
      "kind": "math",
      "x": 40,
      "y": 7251,
      "src": "u_per := T_r/Rd_per ="
    },
    {
      "id": "r122",
      "kind": "math",
      "x": 40,
      "y": 7297,
      "src": "u_flu := T_r/Rd_flu ="
    },
    {
      "id": "r123",
      "kind": "math",
      "x": 40,
      "y": 7343,
      "src": "u_rot := T_r/Rd_rot ="
    },
    {
      "id": "r124",
      "kind": "math",
      "x": 40,
      "y": 7389,
      "src": "u_sol := T_r/Rd_sol ="
    },
    {
      "id": "r125",
      "kind": "math",
      "x": 40,
      "y": 7435,
      "src": "u_max := max(u_pan, u_dro, u_len, u_dfl, u_bc, u_per, u_flu, u_rot, u_sol) ="
    },
    {
