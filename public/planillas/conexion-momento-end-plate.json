      "src": "d_h := 2.6 cm"
    },
    {
      "id": "r034",
      "kind": "math",
      "x": 40,
      "y": 1973,
      "src": "d_hn := d_h + 0.2 cm"
    },
    {
      "id": "r035",
      "kind": "math",
      "x": 40,
      "y": 2019,
      "src": "p_f := 4.5 cm"
    },
    {
      "id": "r036",
      "kind": "math",
      "x": 40,
      "y": 2065,
      "src": "L_e := 4.0 cm"
    },
    {
      "id": "r037",
      "kind": "math",
      "x": 40,
      "y": 2111,
      "src": "g := 10.0 cm"
    },
    {
      "id": "r038",
      "kind": "math",
      "x": 40,
      "y": 2157,
      "src": "w_s := 1.0 cm"
    },
    {
      "id": "r039",
      "kind": "text",
      "x": 40,
      "y": 2226,
      "src": "━━ DATOS · SOLICITACIÓN (LRFD) ━━"
    },
    {
      "id": "r040",
      "kind": "math",
      "x": 40,
      "y": 2272,
      "src": "M_u := 32 tonf*m"
    },
    {
      "id": "r041",
      "kind": "math",
      "x": 40,
      "y": 2318,
      "src": "V_u := 15 tonf"
    },
    {
      "id": "r042",
      "kind": "math",
      "x": 40,
      "y": 2364,
      "src": "H := 3.5 m"
    },
    {
      "id": "r043",
      "kind": "math",
      "x": 40,
      "y": 2410,
      "src": "V_col := M_u/H = tonf"
    },
    {
      "id": "r044",
      "kind": "text",
      "x": 40,
      "y": 2479,
      "src": "━━ 1 · EL PAR: DE MOMENTO A FUERZAS ━━"
    },
    {
      "id": "r045",
      "kind": "text",
      "x": 40,
      "y": 2525,
      "src": "El par se forma entre los centros de las alas; el ala comprimida apoya por contacto directo"
    },
    {
      "id": "r046",
      "kind": "math",
      "x": 40,
      "y": 2571,
      "src": "T_f := M_u/(d_v - t_fv) = tonf"
    },
    {
      "id": "r047",
      "kind": "math",
      "x": 40,
      "y": 2617,
      "src": "T_4 := T_f/4 = tonf"
    },
    {
      "id": "r048",
      "kind": "text",
      "x": 40,
      "y": 2686,
      "src": "━━ 2 · PERNOS A TRACCIÓN SIN PALANCA (Ec. J3-1, phi = 0.75) ━━"
    },
    {
      "id": "r049",
      "kind": "text",
      "x": 40,
      "y": 2732,
      "src": "B_r = phi·r_n del perno: la referencia. Pero J3.7 obliga a sumar la tracción por palanca"
    },
    {
      "id": "r050",
      "kind": "math",
      "x": 40,
      "y": 2778,
      "src": "B_r := 0.75*F_nt*A_b = kgf"
    },
    {
      "id": "v_sin",
      "kind": "math",
      "x": 40,
      "y": 2824,
      "src": "B_r >= T_4 ="
    },
    {
      "id": "r051",
      "kind": "text",
      "x": 40,
      "y": 2893,
      "src": "━━ 3 · EFECTO PALANCA — modelo T-stub (Manual Parte 9) ━━"
    },
    {
      "id": "r052",
      "kind": "text",
      "x": 40,
      "y": 2939,
      "src": "La placa flecta, apoya en su borde y devuelve al perno una fuerza q: el perno no ve T/4, ve T/4 + q"
    },
    {
      "id": "r053",
      "kind": "math",
      "x": 40,
      "y": 2985,
      "src": "p_t := b_p/2 = cm"
    },
    {
      "id": "r054",
      "kind": "math",
      "x": 40,
      "y": 3031,
      "src": "b_ts := p_f = cm"
    },
    {
      "id": "r055",
      "kind": "math",
      "x": 40,
      "y": 3077,
      "src": "b_pr := b_ts - d_b/2 = cm"
    },
    {
      "id": "r056",
      "kind": "text",
      "x": 40,
      "y": 3123,
      "src": "El tope 1.25·b evita darle crédito a un voladizo largo que no participa"
    },
    {
      "id": "r057",
      "kind": "math",
      "x": 40,
      "y": 3169,
      "src": "a_ts := min(L_e, 1.25*b_ts) = cm"
    },
    {
      "id": "r058",
      "kind": "math",
      "x": 40,
      "y": 3215,
      "src": "a_pr := a_ts + d_b/2 = cm"
    },
    {
      "id": "r059",
      "kind": "math",
      "x": 40,
      "y": 3261,
      "src": "rho := b_pr/a_pr ="
    },
    {
      "id": "r060",
      "kind": "math",
      "x": 40,
      "y": 3307,
      "src": "delta := 1 - d_h/p_t ="
    },
    {
      "id": "r061",
      "kind": "text",
      "x": 40,
      "y": 3353,
      "src": "El espesor crítico (Manual Ec. 9-26): con t_p >= t_c la palanca desaparece y el perno rinde B_r limpio"
    },
    {
      "id": "r062",
      "kind": "math",
      "x": 40,
      "y": 3399,
      "src": "t_c := sqrt(4*B_r*b_pr/(0.90*p_t*F_up)) = cm"
    },
    {
      "id": "r063",
      "kind": "text",
      "x": 40,
      "y": 3445,
      "src": "Con la placa adoptada de 22 mm (Manual Ec. 9-30):"
    },
    {
      "id": "r064",
      "kind": "math",
      "x": 40,
      "y": 3491,
      "src": "alp_22 := min(1, ((t_c/t_p)^2 - 1)/(delta*(1 + rho))) ="
    },
    {
      "id": "r065",
      "kind": "math",
      "x": 40,
      "y": 3537,
      "src": "T_22 := B_r*(t_p/t_c)^2*(1 + delta*alp_22) = tonf"
    },
    {
      "id": "v_pal",
      "kind": "math",
      "x": 40,
      "y": 3583,
      "src": "T_22 >= T_4 ="
    },
    {
      "id": "r066",
      "kind": "text",
      "x": 40,
      "y": 3629,
      "src": "La tabla del post — la capacidad del perno como FUNCIÓN del espesor de la placa:"
    },
    {
      "id": "r067",
      "kind": "math",
      "x": 40,
      "y": 3675,
      "src": "alp_18 := min(1, ((t_c/(1.8 cm))^2 - 1)/(delta*(1 + rho))) ="
    },
    {
      "id": "r068",
      "kind": "math",
      "x": 40,
      "y": 3721,
      "src": "T_18 := B_r*((1.8 cm)/t_c)^2*(1 + delta*alp_18) = tonf"
    },
    {
      "id": "r069",
      "kind": "text",
      "x": 40,
      "y": 3767,
      "src": "Con 18 mm la conexión FALLA (uso 1.15) con los mismos pernos — la tesis del post:"
    },
    {
      "id": "v_18",
      "kind": "math",
      "x": 40,
      "y": 3813,
      "src": "T_18 < T_4 ="
    },
    {
      "id": "r070",
      "kind": "math",
      "x": 40,
      "y": 3859,
      "src": "alp_20 := min(1, ((t_c/(2.0 cm))^2 - 1)/(delta*(1 + rho))) ="
    },
    {
      "id": "r071",
      "kind": "math",
      "x": 40,
      "y": 3905,
      "src": "T_20 := B_r*((2.0 cm)/t_c)^2*(1 + delta*alp_20) = tonf"
    },
    {
      "id": "r072",
      "kind": "math",
      "x": 40,
      "y": 3951,
      "src": "alp_25 := min(1, ((t_c/(2.5 cm))^2 - 1)/(delta*(1 + rho))) ="
    },
    {
      "id": "r073",
      "kind": "math",
      "x": 40,
      "y": 3997,
      "src": "T_25 := B_r*((2.5 cm)/t_c)^2*(1 + delta*alp_25) = tonf"
    },
    {
      "id": "r074",
      "kind": "text",
      "x": 40,
      "y": 4043,
      "src": "El cruce curva–demanda de la figura: espesor mínimo, en la rama de palanca plena (alpha = 1, factor 1 + delta)"
    },
    {
      "id": "r075",
      "kind": "math",
      "x": 40,
      "y": 4089,
      "src": "t_min := t_c*sqrt(T_4/((1 + delta)*B_r)) = cm"
    },
    {
      "id": "v_rama",
      "kind": "math",
      "x": 40,
      "y": 4135,
      "src": "t_min <= t_c/sqrt(1 + delta*(1 + rho)) ="
    },
    {
      "id": "r076",
      "kind": "text",
      "x": 40,
      "y": 4204,
      "src": "━━ 4 · LA PLACA DE EXTREMO EN CORTE (Ecs. J4-3 y J4-4) ━━"
    },
    {
      "id": "r077",
      "kind": "text",
      "x": 40,
      "y": 4250,
      "src": "La porción extendida lleva T/2; el ancho resistente es el b_p completo (Design Guide 4)"
    },
    {
      "id": "r078",
      "kind": "math",
      "x": 40,
      "y": 4296,
      "src": "T_2 := T_f/2 = tonf"
    },
    {
      "id": "r079",
      "kind": "math",
      "x": 40,
      "y": 4342,
      "src": "Rd_pfl := 1.00*0.6*F_yp*b_p*t_p = tonf"
    },
    {
      "id": "r080",
      "kind": "math",
      "x": 40,
      "y": 4388,
      "src": "Rd_pro := 0.75*0.6*F_up*(b_p - 2*d_hn)*t_p = tonf"
    },
    {
      "id": "v_pfl",
      "kind": "math",
      "x": 40,
      "y": 4434,
      "src": "Rd_pfl >= T_2 ="
    },
    {
      "id": "v_pro",
      "kind": "math",
      "x": 40,
      "y": 4480,
      "src": "Rd_pro >= T_2 ="
    },
    {
      "id": "r081",
      "kind": "text",
      "x": 40,
      "y": 4549,
      "src": "━━ 5 · SOLDADURA ALA–PLACA (Ec. J2-4, phi = 0.75) ━━"
    },
    {
      "id": "r082",
      "kind": "text",
      "x": 40,
      "y": 4595,
      "src": "Fuerza PERPENDICULAR al eje del filete: aplica el incremento direccional k_ds de la Ec. J2-5"
    },
    {
      "id": "r083",
      "kind": "math",
      "x": 40,
      "y": 4641,
      "src": "k_ds := 1 + 0.5*sin(pi/2)^1.5 ="
    },
    {
      "id": "r084",
      "kind": "math",
      "x": 40,
      "y": 4687,
      "src": "rn_w := 0.75*0.6*F_EXX*0.707*w_s*k_ds = kgf/cm"
    },
    {
      "id": "r085",
      "kind": "text",
      "x": 40,
      "y": 4733,
      "src": "Longitud: cara exterior del ala (b_f) más dos tramos interiores de (b_f - t_w)/2"
    },
    {
      "id": "r086",
      "kind": "math",
      "x": 40,
      "y": 4779,
      "src": "L_w := 2*b_fv - t_wv = cm"
    },
    {
      "id": "r087",
      "kind": "math",
      "x": 40,
      "y": 4825,
      "src": "Rd_sol := rn_w*L_w = tonf"
    },
    {
      "id": "v_sol",
      "kind": "math",
      "x": 40,
      "y": 4871,
      "src": "Rd_sol >= T_f ="
    },
    {
      "id": "r088",
      "kind": "text",
      "x": 40,
      "y": 4917,
      "src": "Sin el crédito transversal (k_ds = 1) el filete de 10 mm NO alcanzaría:"
    },
    {
      "id": "r089",
      "kind": "math",
      "x": 40,
      "y": 4963,
      "src": "Rd_ssin := Rd_sol/k_ds = tonf"
    },
    {
      "id": "v_ssin",
      "kind": "math",
      "x": 40,
      "y": 5009,
      "src": "Rd_ssin < T_f ="
    },
    {
      "id": "r090",
      "kind": "text",
      "x": 40,
      "y": 5078,
      "src": "━━ 6 · PERNOS INFERIORES A CORTE (Ec. J3-1, phi = 0.75) ━━"
    },
    {
      "id": "r091",
      "kind": "text",
      "x": 40,
      "y": 5124,
      "src": "El corte va a los 4 pernos de la zona comprimida: sin tracción, no hay interacción J3.8 que revisar"
    },
    {
      "id": "r092",
      "kind": "math",
      "x": 40,
      "y": 5170,
      "src": "Rd_cor := 4*0.75*F_nv*A_b = tonf"
    },
    {
      "id": "v_cor",
      "kind": "math",
      "x": 40,
      "y": 5216,
      "src": "Rd_cor >= V_u ="
    },
    {
      "id": "r093",
      "kind": "text",
      "x": 40,
      "y": 5285,
      "src": "━━ 7 · LA COLUMNA (J10) — el par entra concentrado en dos líneas ━━"
    },
    {
      "id": "r094",
      "kind": "text",
      "x": 40,
      "y": 5331,
      "src": "l_b = ala de la viga repartida a 45° a través de la placa: t_f,viga + 2·t_p"
    },
    {
      "id": "r095",
      "kind": "math",
      "x": 40,
      "y": 5377,
      "src": "l_b := t_fv + 2*t_p = cm"
    },
    {
      "id": "r096",
      "kind": "math",
      "x": 40,
      "y": 5423,
      "src": "Rd_fla := 0.90*6.25*F_yc*t_fc^2 = tonf"
    },
    {
      "id": "v_fla",
      "kind": "math",
      "x": 40,
      "y": 5469,
      "src": "Rd_fla >= T_f ="
    },
    {
      "id": "r097",
      "kind": "math",
      "x": 40,
      "y": 5515,
      "src": "Rd_alma := 1.00*F_yc*t_wc*(5*k_c + l_b) = tonf"
    },
    {
      "id": "v_alma",
      "kind": "math",
      "x": 40,
      "y": 5561,
      "src": "Rd_alma >= T_f ="
    },
    {
      "id": "r098",
      "kind": "math",
      "x": 40,
      "y": 5607,
      "src": "Rd_apl := 0.75*0.80*t_wc^2*(1 + 3*(l_b/d_c)*(t_wc/t_fc)^1.5)*sqrt(E*F_yc*t_fc/t_wc) = tonf"
    },
    {
