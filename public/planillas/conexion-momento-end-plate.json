    },
    {
      "id": "r028",
      "kind": "text",
      "x": 40,
      "y": 1389,
      "src": "t_p se ADOPTA en 22 mm: es LA variable del ejemplo (§3 recorre 18, 20, 22, 25 y 31.1 mm)"
    },
    {
      "id": "r029",
      "kind": "math",
      "x": 40,
      "y": 1435,
      "src": "t_p := 2.2 cm"
    },
    {
      "id": "r030",
      "kind": "math",
      "x": 40,
      "y": 1481,
      "src": "d_b := 2.4 cm"
    },
    {
      "id": "r031",
      "kind": "text",
      "x": 40,
      "y": 1527,
      "src": "A_b nominal del Ø24 (catálogo) · d_h = agujero estándar · d_hn = d_h + 2 mm para áreas netas (B4.3b)"
    },
    {
      "id": "r032",
      "kind": "math",
      "x": 40,
      "y": 1573,
      "src": "A_b := 4.524 cm^2"
    },
    {
      "id": "r033",
      "kind": "math",
